{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izgo.uz/schemas/events/trip.cancelled.v1.json",
  "title": "trip.cancelled",
  "description": "Boshlanmagan safar bekor qilindi. cancelled_by=driver — buyurtma qayta searching (boshqa haydovchilarga); cancelled_by=admin — buyurtma cancelled. Matching haydovchini bo'shatadi.",
  "x-producer": "trip-order",
  "x-nats-subject": "izgo.trip.cancelled.v1",
  "type": "object",
  "required": [
    "event",
    "version",
    "event_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "trip.cancelled"
    },
    "version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Hodisaning noyob ID si (idempotentlik uchun)"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "description": "Ixtiyoriy: so'rov kuzatuvi uchun (X-Request-ID)"
    },
    "payload": {
      "type": "object",
      "required": [
        "trip_id",
        "order_id",
        "driver_id",
        "passenger_id",
        "at",
        "cancelled_by",
        "order_status"
      ],
      "additionalProperties": false,
      "properties": {
        "trip_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "driver_id": {
          "type": "string",
          "format": "uuid"
        },
        "passenger_id": {
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "cancelled_by": {
          "enum": [
            "driver",
            "admin"
          ]
        },
        "order_status": {
          "enum": [
            "searching",
            "cancelled"
          ]
        }
      }
    }
  }
}
