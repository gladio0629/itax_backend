{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izgo.uz/schemas/events/offer.created.v1.json",
  "title": "offer.created",
  "description": "Buyurtma uchun haydovchiga taklif yuborildi. Trip & Order taklifni saqlagan tranzaksiyada chiqaradi (offer_id = qabul qilishdagi ID). matching-geo /find da order_id berilganda ham chiqarishi mumkin, lekin trip-order order_id yubormaydi.",
  "x-producer": "trip-order",
  "x-nats-subject": "izgo.offer.created.v1",
  "type": "object",
  "required": [
    "event",
    "version",
    "event_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "offer.created"
    },
    "version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Hodisaning noyob ID si (idempotentlik uchun)"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "description": "Ixtiyoriy: so'rov kuzatuvi uchun (X-Request-ID)"
    },
    "payload": {
      "type": "object",
      "required": [
        "offer_id",
        "order_id",
        "driver_id",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "driver_id": {
          "type": "string",
          "format": "uuid"
        },
        "eta_s": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
