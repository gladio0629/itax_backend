{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izgo.uz/schemas/events/user.created.v1.json",
  "title": "user.created",
  "description": "Yangi foydalanuvchi ro'yxatdan o'tdi (OTP tasdiqlangandan keyin).",
  "x-producer": "identity",
  "x-nats-subject": "izgo.user.created.v1",
  "type": "object",
  "required": [
    "event",
    "version",
    "event_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "user.created"
    },
    "version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Hodisaning noyob ID si (idempotentlik uchun)"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "description": "Ixtiyoriy: so'rov kuzatuvi uchun (X-Request-ID)"
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "phone",
        "role",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+998[0-9]{9}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "passenger",
            "driver"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
