{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izgo.uz/schemas/events/driver.submitted.v1.json",
  "title": "driver.submitted",
  "description": "Haydovchi ro'yxatdan o'tish arizasini tekshiruvga yubordi.",
  "x-producer": "driver",
  "x-nats-subject": "izgo.driver.submitted.v1",
  "type": "object",
  "required": [
    "event",
    "version",
    "event_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "driver.submitted"
    },
    "version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Hodisaning noyob ID si (idempotentlik uchun)"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "description": "Ixtiyoriy: so'rov kuzatuvi uchun (X-Request-ID)"
    },
    "payload": {
      "type": "object",
      "required": [
        "driver_id",
        "user_id",
        "document_ids",
        "submitted_at"
      ],
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
