# ============================================================================================
# F-16 (Etap 7): MAXFIY QIYMATLAR .env DA SAQLANMAYDI. Ular secrets/ ostidagi fayllarda (Docker secrets):
#   ./scripts/gen-secrets.sh   (./scripts/up.sh o'zi chaqiradi) — yaratadi, .env dagi eski qiymatlarni ko'chiradi.
#   secrets/postgres/*                 postgres superuser + har servis DB paroli
#   secrets/svc/<servis>/<NOM>         servisga /run/secrets/izgo/<NOM> sifatida ulanadi (fayl nomi = env nomi)
#   secrets/internal/<servis>.token    servislararo token (F-02; ruxsatlar infra/mtls/policy.json)
#   secrets/mtls/                      dev CA va servis sertifikatlari (F-02 bosqich 2)
#   secrets/external/                  tashqi kalitlarning asl nusxasi (Hamkorbank — hali ishlatilmaydi; Mapbox —
#                                      gen-secrets.sh uni secrets/svc/pricing va secrets/svc/matching-geo ga nusxalaydi)
# Quyidagi POSTGRES_PASSWORD, *_DB_PASSWORD, INTERNAL_TOKENS, UPLOAD_SIGNING_SECRET, SMS_PROVIDER_KEY, EMAIL_API_KEY,
# HAMKORBANK_MERCHANT_*, MAPBOX_TOKEN BO'SH qoldiriladi; qiymat yozilsa gen-secrets.sh uni faylga ko'chirib, bo'shatadi.
# ============================================================================================

# ============================================
# IZGO Backend — muhit o'zgaruvchilari
# ============================================
# Maxfiy qiymatlar faqat .env da (gitga kirmaydi). .env.example da faqat nomlar.
# Bo'sh qoldirilgan o'zgaruvchi uchun docker-compose.yml dagi default ishlaydi (izohda "bo'sh = ...").

# ---------- PostgreSQL ----------
# Barcha servislar uchun umumiy baza (har servisga alohida DB va foydalanuvchi)
# Postgres superuser nomi (majburiy; up.sh bo'sh bo'lsa vaqtincha izgo ishlatadi)
POSTGRES_USER=
# Superuser paroli — up.sh bo'sh bo'lsa avtomatik yaratadi
POSTGRES_PASSWORD=
# Host'dagi port (5432 band bo'lsa boshqasini bering); bo'sh = 5432
POSTGRES_HOST_PORT=

# ---------- Servis bazalari parollari ----------
# Bo'sh bo'lsa POSTGRES_PASSWORD ishlatiladi (infra/postgres/init-databases.sh)
# identity_db (identity_svc)
IDENTITY_DB_PASSWORD=
# driver_db
DRIVER_DB_PASSWORD=
# trip_order_db
TRIP_ORDER_DB_PASSWORD=
# pricing_db
PRICING_DB_PASSWORD=
# wallet_db
WALLET_DB_PASSWORD=
# backoffice_db
BACKOFFICE_DB_PASSWORD=

# ---------- Redis ----------
# Kesh, OTP kodlari, limitlar, bildirishnomalar
# bo'sh = redis://redis:6379
REDIS_URL=

# ---------- NATS ----------
# Servislararo hodisalar (JetStream)
# bo'sh = nats://nats:4222
NATS_URL=tls://nats:4222

# ---------- JWT kalitlar ----------
# gen-jwt-keys.sh avtomatik yaratadi (secrets/jwt/). Compose konteynerga /run/secrets/jwt ni o'zi beradi
# Ed25519 maxfiy kalit (faqat identity imzolaydi)
JWT_PRIVATE_KEY_PATH=
# Ed25519 ochiq kalit (barcha servislar tekshiradi)
JWT_PUBLIC_KEY_PATH=
# Token `iss` qiymati, hamma servisda bir xil; bo'sh = izgo-identity
JWT_ISSUER=

# ---------- Ichki servislar aloqasi ----------
# Servislar bir-birini chaqirish uchun (X-Internal-Token)
# Umumiy sir, kamida 16 belgi; vergul bilan bir nechta (almashtirish uchun) — up.sh avtomatik yaratadi
INTERNAL_TOKENS=
# bo'sh = http://identity:8010
IDENTITY_INTERNAL_URL=
# bo'sh = http://driver:8011
DRIVER_INTERNAL_URL=
# bo'sh = http://matching-geo:8013
MATCHING_URL=
# bo'sh = http://pricing:8014
PRICING_URL=
# bo'sh = http://wallet:8015
WALLET_URL=
# Ichki so'rov timeout (ms); bo'sh = 3000
INTERNAL_HTTP_TIMEOUT_MS=
# Backoffice: yo'lovchi/haydovchi ma'lumotini olish — http | mock; bo'sh = http
INTERNAL_LOOKUP_MODE=

# ---------- SMS provayder (smsxabarnoma.uz) ----------
# Yo'lovchi va haydovchi OTP kodi uchun (identity, notification)
# API manzili
SMS_PROVIDER_URL=
# API kalit (X-API-Key)
SMS_PROVIDER_KEY=
# mock = logga yozadi; real = SMS yuboradi (kalit bo'sh bo'lsa baribir mock)
SMS_MODE=

# ---------- Email provayder (Resend) ----------
# Admin kirish kodi uchun (identity)
# Hozircha faqat resend
EMAIL_PROVIDER=
# Resend API kalit
EMAIL_API_KEY=
# Jo'natuvchi manzil (Resend'da tasdiqlangan domen)
EMAIL_FROM=
# mock = logga yozadi; real = email yuboradi (kalit bo'sh bo'lsa baribir mock)
EMAIL_MODE=

# ---------- Hamyon (wallet) ----------
# To'lov rejimi va komissiya
# Wallet hozir faqat shuni o'qiydi: mock | real (real provayder kodi hali yoqilmagan); bo'sh = mock
PAYMENT_MODE=
# Komissiya, bazis punktlarda (1000 = 10%); bo'sh = 1000
COMMISSION_BPS=

# ---------- Hamkorbank (karta to'lov) ----------
# Haydovchi hamyoniga pul tushishi va karta ulash uchun
# Hozircha hech bir servis o'qimaydi (wallet mock) — real integratsiya uchun tayyor
# API manzili
HAMKORBANK_API_URL=
# Merchant kaliti
HAMKORBANK_MERCHANT_KEY=
# Merchant siri
HAMKORBANK_MERCHANT_SECRET=
# mock | real
HAMKORBANK_MODE=
# Eski nom (wallet RealProviders.kt izohida) — HAMKORBANK_API_URL bilan bir xil ma'no
HAMKORBANK_BASE_URL=
# Eski nom (wallet RealProviders.kt izohida)
HAMKORBANK_API_KEY=

# ---------- Payme ----------
# Yo'lovchi to'lovi uchun. Hozircha hech bir servis o'qimaydi (wallet mock)
# Merchant ID
PAYME_MERCHANT_ID=
# Merchant API kaliti (Basic auth: Paycom:<PAYME_KEY>)
PAYME_KEY=
# mock | real
PAYME_MODE=

# ---------- Click ----------
# Yo'lovchi to'lovi uchun. Hozircha hech bir servis o'qimaydi (wallet mock)
# Merchant ID
CLICK_MERCHANT_ID=
# Service ID
CLICK_SERVICE_ID=
# Imzo uchun maxfiy kalit
CLICK_SECRET_KEY=
# mock | real
CLICK_MODE=
# Eski nom (wallet RealProviders.kt izohida) — CLICK_SECRET_KEY bilan bir xil ma'no
CLICK_KEY=

# ---------- Push bildirishnomalar (Firebase) ----------
# Buyurtma holati, taklif va ogohlantirish uchun. Hozircha notification push mock
# Firebase kaliti
FCM_KEY=
# mock | real
FCM_MODE=

# ---------- Bildirishnomalar servisi (notification) ----------
# Mock SMS matnini (OTP kodi bilan) logga yozish — faqat dev; bo'sh = true
MOCK_LOG_SMS_PARAMS=
# Bir foydalanuvchiga WebSocket ulanishlar soni; bo'sh = 3
WS_MAX_CONNS=

# ---------- Xarita (Mapbox Directions: pricing, matching-geo) ----------
# Yo'l masofasi va davomiyligi (narx, ETA, /internal/matching/route) Mapbox Directions API dan olinadi.
# Mapbox access token (maxfiy: gen-secrets.sh faylga ko'chirib, bu yerni bo'shatadi)
MAPBOX_TOKEN=
# mock | real; bo'sh = token bo'lsa real, bo'lmasa mock. mock — Mapbox chaqirilmaydi (faqat Haversine)
MAPBOX_MODE=

# ---------- Narx va marshrut (pricing, matching-geo) ----------
# Mapbox o'chirilgan yoki javob bermaganda (zaxira): masofa = Haversine × ROAD_FACTOR, vaqt = masofa / AVG_SPEED_KMH
# To'g'ri chiziqdan yo'l masofasiga koeffitsient; bo'sh = 1.3
ROAD_FACTOR=
# O'rtacha tezlik (km/soat); bo'sh = 30
AVG_SPEED_KMH=
# Pricing: tariflar keshi muddati; bo'sh = 5m
TARIFF_CACHE_TTL=
# Matching: joylashuv shuncha yangilanmasa haydovchi xaritadan o'chadi; bo'sh = 2m
LOCATION_TTL=
# Matching: GPS sakrashini aniqlash chegarasi (km/soat); bo'sh = 300
MAX_SPEED_KMH=
# Matching: haydovchi qidirish radiusi (metr); bo'sh = 50000
DEFAULT_RADIUS_M=

# ---------- Fayl yuklash (Driver hujjatlar) ----------
# Imzolangan yuklash URL lari uchun HMAC kalit, kamida 16 belgi — up.sh avtomatik yaratadi
UPLOAD_SIGNING_SECRET=
# Mijoz ko'radigan manzil (Kong); upload_url shu bilan boshlanadi; bo'sh = http://localhost:8000
PUBLIC_BASE_URL=

# ---------- Haydovchi arizalarini tasdiqlash ----------
# DEMO: ariza avtomatik tasdiqlansinmi (driver); bo'sh = true
AUTO_APPROVE_ENABLED=
# Avtomatik tasdiqlashgacha kutish (ms); bo'sh = 5000
AUTO_APPROVE_DELAY_MS=
# Avtomatik tasdiqlovchi tizim ID si (UUID); bo'sh = 00000000-0000-0000-0000-000000000001
APPROVAL_SYSTEM_ACTOR_ID=
# Backoffice: operator "resolved" qilsa driver.approved hodisasi chiqarilsinmi; bo'sh = true
PUBLISH_APPROVED_ON_RESOLVED=

# ---------- Admin (backoffice) ----------
# Birinchi superadmin — ixtiyoriy; kirish baribir OTP orqali
# Superadmin email (telefon bilan birga beriladi)
ADMIN_BOOTSTRAP_EMAIL=
# Superadmin telefoni, +998XXXXXXXXX
ADMIN_BOOTSTRAP_PHONE=
# To'liq ism; bo'sh = Superadmin
ADMIN_BOOTSTRAP_NAME=
# Hisobotlarda "bugun" chegarasi uchun UTC farqi (soat); bo'sh = 5
TZ_OFFSET_HOURS=

# ---------- API gateway (Kong) ----------
# Kong admin API manzili — hozircha hech bir servis/skript o'qimaydi
KONG_ADMIN_URL=

# ---------- Dev rejimi (FAQAT lokal; productionda bo'sh/false) ----------
# Muhit nomi; production bo'lsa DEV_MODE bilan identity ishga tushmaydi. bo'sh = development
APP_ENV=
# true: DEV_TEST_* ro'yxatidagi telefon/email'lar uchun OTP = DEV_OTP_CODE (docs/dev-testing.md). bo'sh = false
DEV_MODE=
# 6 raqam (DEV_MODE=true bo'lsa majburiy). Repoga yozilmaydi
DEV_OTP_CODE=
# Vergul bilan E.164 telefonlar (masalan +998900000001,...)
DEV_TEST_PHONES=
# Vergul bilan test email'lar
DEV_TEST_EMAILS=

# ---------- WebSocket (notification) ----------
# Birinchi xabar (auth) kutish vaqti; bo'sh = 5s
WS_AUTH_TIMEOUT=
# Eski /ws?token= usuli; frontend subprotocol'ga o'tgach false. bo'sh = true
WS_ALLOW_QUERY_TOKEN=
# Brauzer Origin host'lari (vergul bilan): 3 ta frontend domeni + localhost:*
WS_ALLOWED_ORIGINS=

# ---------- Hosting (HTTPS/WSS) ----------
# API domeni (docker compose --profile tls): Caddy shu domen uchun sertifikat oladi. docs/hosting.md
API_DOMAIN=
